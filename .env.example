# This repo is a pure client of the shared Convex deployment owned by
# ../student-semester-reminder — see BACKEND.md. Copy this file to .env.local and
# fill in the values (same values as the mobile repo's own .env.local, since both
# apps point at the same deployment).

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=

NEXT_PUBLIC_CONVEX_SITE_URL=

# Resend API key for email OTP verification
AUTH_RESEND_KEY=
